# Project environment
FYP_ENV=development

# Local runtime data directory
FYP_DATA_DIR=./data

# Initial experiment/application metadata database.
# The project starts with SQLite; this may be changed only through a documented design decision.
FYP_DATABASE_URL=sqlite:///./data/fyp.db

# Cloud LLM credentials are intentionally NOT defined during repository foundation.
# Add provider-specific variables only when that provider is implemented.

# Sentinel operator console (localhost only; no secrets in source control)
# FYP_DASHBOARD_DATABASE=./data/fyp.db
# FYP_MODEL_DIRECTORY=/absolute/path/to/approved/gguf/models
# FYP_LLAMA_SERVER_BIN=/absolute/path/to/pinned/llama-server
# FYP_LOCAL_MODEL_PORT=18083
# FYP_CONSOLE_EVIDENCE_DIR=/absolute/path/outside/repo/capability-evidence
